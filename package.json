{
  "name": "string-savings-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Audit web retrieval workflows and estimate total String, compute and model-context costs.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "string-savings": "./cli.ts"
  },
