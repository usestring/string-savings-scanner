    "test": "bun test"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
